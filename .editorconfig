# Pins the style ktlint enforces so it cannot drift between machines and CI (CLAUDE.md §5).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 120

# Compose composables are PascalCase by convention, which the stock naming rule reads as a
# violation. Everything else in the ruleset stays on.
ktlint_function_naming_ignore_when_annotated_with = Composable, Test

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
